{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "spychau-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-22",
  "vars": {
    "TRIBUTE_PAYMENTS_ENABLED": "false",
    "TRIBUTE_CHECKOUT_URL": "https://t.me/tribute/app?startapp=s1b9w"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "JOURNAL",
      "bucket_name": "spychau-journal-dev"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/app.js", "/src/styles.css", "/api/*", "/webhooks/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spychau-bot-dev",
      "database_id": "35ee6b34-0c59-4ec2-8b24-4b18b4356120",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "r2_buckets": [
      {
        "binding": "JOURNAL",
        "bucket_name": "spychau-journal-dev"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "spychau-bot-dev",
        "database_id": "35ee6b34-0c59-4ec2-8b24-4b18b4356120",
        "migrations_dir": "migrations"
      }
    ]
  },
  "env": {
    "production": {
      "name": "spychau-bot-production",
      "vars": {
        "TRIBUTE_PAYMENTS_ENABLED": "true",
        "TRIBUTE_CHECKOUT_URL": "https://t.me/tribute/app?startapp=s1b9w",
        "TRIBUTE_PRODUCTS": "{\"personal_package:pack100\":{\"web_link\":\"https://web.tribute.tg/p/J0r\",\"amount_rub\":189}}",
        "PAYMENTS_TERMS_VERSION": "2026-11-02",
        "PAYMENTS_TERMS_TEXT": "SpySkaut — условия оплаты\n\nПодписка «Безлимит» открывает функции личных чатов на срок, выбранный на странице Tribute. Подписка продлевается автоматически; период и сумма указаны в Tribute. Автопродление можно отключить там же.\n\nПакет включает указанное при покупке число событий. За каждое новое событие, переданное Telegram подключённому боту, списывается одно событие из пакета. Пакет не сгорает. Историю до подключения восстановить нельзя.\n\nДоступ и пакет активируются после подтверждения оплаты Tribute. Доступные способы оплаты и итоговая сумма отображаются перед подтверждением платежа.\n\nИсполнитель: самозанятый Арсений В. Б.\nПоддержка по оплате и доступу: ssenba154@gmail.com",
        "PAYMENTS_SUPPORT_URL": "mailto:ssenba154@gmail.com"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "r2_buckets": [
        {
          "binding": "JOURNAL",
          "bucket_name": "spychau-journal-production"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "spychau-bot-production",
          "database_id": "740e8473-d7f0-4a72-9e26-4af8f8303a0a",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
