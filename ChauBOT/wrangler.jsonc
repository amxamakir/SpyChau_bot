{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "spychau-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-22",
  "vars": {
    "TRIBUTE_PAYMENTS_ENABLED": "false",
    "TRIBUTE_CHECKOUT_URL": "https://t.me/tribute/app?startapp=s1b9w"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "JOURNAL",
      "bucket_name": "spychau-journal-dev"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/app.js", "/src/styles.css", "/api/*", "/webhooks/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spychau-bot-dev",
      "database_id": "35ee6b34-0c59-4ec2-8b24-4b18b4356120",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "r2_buckets": [
      {
        "binding": "JOURNAL",
        "bucket_name": "spychau-journal-dev"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "spychau-bot-dev",
        "database_id": "35ee6b34-0c59-4ec2-8b24-4b18b4356120",
        "migrations_dir": "migrations"
      }
    ]
  },
  "env": {
    "production": {
      "name": "spychau-bot-production",
      "vars": {
        "TRIBUTE_PAYMENTS_ENABLED": "true",
        "TRIBUTE_CHECKOUT_URL": "https://t.me/tribute/app?startapp=s1b9w",
        "TRIBUTE_PRODUCTS": "{\"personal_package:pack100\":{\"web_link\":\"https://web.tribute.tg/p/J2d\",\"telegram_link\":\"https://t.me/tribute/app?startapp=pJ2d\",\"amount_rub\":189},\"personal_package:pack300\":{\"web_link\":\"https://web.tribute.tg/p/J8f\",\"telegram_link\":\"https://t.me/tribute/app?startapp=pJ8f\",\"amount_rub\":499},\"personal_package:pack500\":{\"web_link\":\"https://web.tribute.tg/p/J8g\",\"telegram_link\":\"https://t.me/tribute/app?startapp=pJ8g\",\"amount_rub\":699},\"personal_unlimited:month\":{\"web_link\":\"https://web.tribute.tg/p/Jgb\",\"telegram_link\":\"https://t.me/tribute/app?startapp=pJgb\",\"amount_rub\":249},\"personal_unlimited:half-year\":{\"web_link\":\"https://web.tribute.tg/p/Jge\",\"telegram_link\":\"https://t.me/tribute/app?startapp=pJge\",\"amount_rub\":1190},\"personal_unlimited:year\":{\"web_link\":\"https://web.tribute.tg/p/Jgf\",\"telegram_link\":\"https://t.me/tribute/app?startapp=pJgf\",\"amount_rub\":1790},\"groups:groups3\":{\"web_link\":\"https://web.tribute.tg/p/Jgg\",\"telegram_link\":\"https://t.me/tribute/app?startapp=pJgg\",\"amount_rub\":349},\"groups:groups10\":{\"web_link\":\"https://web.tribute.tg/p/Jgh\",\"telegram_link\":\"https://t.me/tribute/app?startapp=pJgh\",\"amount_rub\":790},\"groups:groups20\":{\"web_link\":\"https://web.tribute.tg/p/Jgi\",\"telegram_link\":\"https://t.me/tribute/app?startapp=pJgi\",\"amount_rub\":1090}}",
        "PAYMENTS_TERMS_VERSION": "2026-11-04",
        "PAYMENTS_TERMS_TEXT": "SpySkaut — условия оплаты\n\nВсе цифровые товары Tribute оформляются как разовые покупки. Товары «Личные чаты — Безлимит» дают доступ к функциям личных чатов на выбранные 1, 6 или 12 месяцев. Автопродления у этих товаров нет.\n\nПакет уведомлений включает указанное при покупке число событий. За каждое новое событие, переданное Telegram подключённому боту, списывается одно событие из пакета. Пакет не сгорает. История до подключения SpySkaut недоступна.\n\nГрупповой товар даёт доступ к подключению указанного числа групп на 1 месяц. Лимиты одновременно действующих групповых товаров складываются; доступ и возможность подключать новые группы прекращаются после окончания соответствующих сроков.\n\nДоступ активируется после подтверждения оплаты Tribute. Доступные способы оплаты и итоговую сумму показывает Tribute до подтверждения платежа.\n\nИсполнитель: самозанятый Арсений В. Б.\nПоддержка по оплате и доступу: ssenba154@gmail.com",
        "PAYMENTS_SUPPORT_URL": "mailto:ssenba154@gmail.com"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "r2_buckets": [
        {
          "binding": "JOURNAL",
          "bucket_name": "spychau-journal-production"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "spychau-bot-production",
          "database_id": "740e8473-d7f0-4a72-9e26-4af8f8303a0a",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
